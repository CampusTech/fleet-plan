# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/fleet-plan
coverage.txt

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# Temp merged config written into the repo by --base/--env (resolveDefaultFile).
# Normally deleted on exit; ignored so a crashed run cannot commit one.
.fleet-plan-default-*.yml
